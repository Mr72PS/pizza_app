# Pizza_App: Vorlage für die Einstellungen. Als .env kopieren und ausfüllen. Die .env gehört nicht ins Repo.

# Erster Admin. Wird nur angelegt, solange es noch keinen Benutzer gibt.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Langer Zufallswert, zum Beispiel aus: openssl rand -hex 32
SESSION_SECRET=

# Adresse, unter der die App im Browser erreichbar ist, ohne Schrägstrich am Ende
BASE_URL=https://pizza.example.lan

# Hinter dem Reverse Proxy auf true lassen, damit IP und HTTPS korrekt erkannt werden
TRUST_PROXY=true

TZ=Europe/Zurich

# Port auf dem Host
PORT=8093

# Benutzer und Gruppe, denen die Dateien im Datenordner gehören sollen. Der Container richtet die Rechte beim Start selbst.
# Auf der Synology per SSH mit «id» nachsehen, wenn du die Dateien in der File Station bearbeiten willst.
PUID=1000
PGID=1000
